using Microsoft.Extensions.Logging;
@using System.Web;

@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

@code {
	private static readonly Microsoft.Extensions.Logging.ILogger _logger = Microsoft.Extensions.Logging.Abstractions.NullLogger.Instance;
    protected override void OnInitialized()
    {       
		_logger.LogError(">>> Entering OnInitialized()");
        var __logStart = System.Diagnostics.Stopwatch.StartNew();
        var returnUrl = HttpUtility.UrlEncode($"/{Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
		_logger.LogError("OnInitialized(): returnUrl → {ReturnUrl}", returnUrl);
        JsRuntime.InvokeVoidAsync("location.replace", $"Identity/Account/Login?returnUrl={returnUrl}");
		_logger.LogError("OnInitialized(): external service call {ReturnUrl} took {Arg1} ms", returnUrl, __logStart.ElapsedMilliseconds);
    _logger.LogWarning("<<< Exiting OnInitialized()");
    }
}