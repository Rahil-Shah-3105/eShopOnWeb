using Microsoft.Extensions.Logging;
@using System.Web;

@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

@code {
	private static readonly Microsoft.Extensions.Logging.ILogger _logger = Microsoft.Extensions.Logging.Abstractions.NullLogger.Instance;
    protected override void OnInitialized()
    {       
        var returnUrl = HttpUtility.UrlEncode($"/{Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
		_logger.LogInformation("OnInitialized(): M2614-AUDIT: Outcome 1: user attribution — Authentication operation completed");
		_logger.LogInformation("OnInitialized(): SOC2-AUDIT [CC6.1]: Authentication operation completed");
        JsRuntime.InvokeVoidAsync("location.replace", $"Identity/Account/Login?returnUrl={returnUrl}");
    }
}