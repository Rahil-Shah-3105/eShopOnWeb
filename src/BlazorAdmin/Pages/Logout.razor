using Microsoft.Extensions.Logging;
@page "/logout"
@inject IJSRuntime JSRuntime
@inject HttpClient HttpClient
@inherits BlazorAdmin.Helpers.BlazorComponent

@code {
private static readonly Microsoft.Extensions.Logging.ILogger _logger = Microsoft.Extensions.Logging.Abstractions.NullLogger.Instance;

    protected override async Task OnInitializedAsync()
    {
        await HttpClient.PostAsync("User/Logout", null);
		_logger.LogInformation("OnInitializedAsync(): HIPAA-AUDIT [§164.312(e)(1)]: Secure PHI transmission completed");
		_logger.LogInformation("OnInitializedAsync(): HIPAA-AUDIT [45 CFR 164.312(d)]: Person or entity authentication — Authentication operation completed");
        await new Route(JSRuntime).RouteOutside("/Identity/Account/Login");
    }

}
