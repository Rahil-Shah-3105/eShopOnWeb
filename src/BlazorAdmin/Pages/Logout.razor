using Microsoft.Extensions.Logging;
@page "/logout"
@inject IJSRuntime JSRuntime
@inject HttpClient HttpClient
@inherits BlazorAdmin.Helpers.BlazorComponent

@code {
private static readonly Microsoft.Extensions.Logging.ILogger _logger = Microsoft.Extensions.Logging.Abstractions.NullLogger.Instance;

    protected override async Task OnInitializedAsync()
    {
        await HttpClient.PostAsync("User/Logout", null);
		_logger.LogInformation("OnInitializedAsync()=null): PCI-AUDIT: Authentication operation completed");
		_logger.LogWarning("OnInitializedAsync()=null): PCI-AUDIT: Outbound notification recorded for the audit trail");
        await new Route(JSRuntime).RouteOutside("/Identity/Account/Login");
    }

}
