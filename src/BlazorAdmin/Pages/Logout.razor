using Microsoft.Extensions.Logging;
@page "/logout"
@inject IJSRuntime JSRuntime
@inject HttpClient HttpClient
@inherits BlazorAdmin.Helpers.BlazorComponent

@code {
private static readonly Microsoft.Extensions.Logging.ILogger _logger = Microsoft.Extensions.Logging.Abstractions.NullLogger.Instance;

    protected override async Task OnInitializedAsync()
    {
		_logger.LogError(">>> Entering OnInitializedAsync()");
        var __logStart = System.Diagnostics.Stopwatch.StartNew();
        await HttpClient.PostAsync("User/Logout", null);
        await new Route(JSRuntime).RouteOutside("/Identity/Account/Login");
		_logger.LogError("OnInitializedAsync(): external service call took {Arg0} ms", __logStart.ElapsedMilliseconds);
    _logger.LogWarning("<<< Exiting OnInitializedAsync()");
    }

}
